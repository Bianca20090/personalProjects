      <aliases enabled='yes' />
      <column caption='Clean Stock Name' datatype='string' name='[Calculation_0844183532617728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Stock Name]=&quot;OKTA&quot; then &quot;Okta&quot;&#13;&#10;ELSEif [Stock Name]=&quot;TSLA&quot; then &quot;Tesla&quot;&#13;&#10;elseif [Stock Name]=&quot;AMZN&quot; then &quot;Amazon&quot;&#13;&#10;elseif [Stock Name]=&quot;BBBY&quot; then &quot;Bed, Bath &amp; Beyond&quot;&#13;&#10;elseif [Stock Name]=&quot;SEDG&quot; then &quot;SolarEdge Technologies&quot;&#13;&#10;END' />
      </column>
      <column caption='Last Closing Price' datatype='real' name='[Calculation_0844183536164865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Date]={MAX([Date])}then [Close] end' />
      </column>
      <column caption='Current Value' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_0844183537115138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0844183536164865]* [Units Bought]' />
      </column>
      <column caption='P/L' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_0844183537307651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0844183537115138]-[Purchase Cost]' />
      </column>
      <column caption='Daily Value' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_0844183542874116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Close]*[Units Bought]' />
      </column>
      <column caption='Red/Green' datatype='string' name='[Calculation_0844183544324101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Daily % change]&lt;0 then &quot;Red&quot;&#13;&#10;ELSEIF [Daily % change]&gt;=0 then &quot;Green&quot;&#13;&#10;end' />
      </column>
      <column caption='Portofolio Value Title' datatype='string' name='[Calculation_1359854835556352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Portofolio Value&quot;' />
      </column>
      <column caption='Profit/Loss Title&quot;' datatype='string' name='[Calculation_1359854838255617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Profit/Loss&quot;' />
      </column>
      <column caption='Profit/Loss %' datatype='real' default-format='p0.00%' name='[Calculation_1359854838833155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0844183537307651])/sum([Purchase Cost])' />
      </column>
      <column caption='Profit/Loss % Title' datatype='string' name='[Calculation_1359854839091204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Profit/Loss %&quot;' />
      </column>
      <column caption='Count of Days' datatype='integer' name='[Calculation_1359854840291334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Date], {MAX([Date])})' />
      </column>
      <column caption='Period Filter' datatype='string' name='[Calculation_1359854841028617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1359854839906309]=&apos;Last 7 Days&apos; AND [Calculation_1359854840291334]&lt;=7 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 4 Weeks&apos; and [Count of Days (copy)_1359854840598535]&lt;=4 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 8 Weeks&apos; and [Count of Days (copy)_1359854840598535]&lt;=8 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 3 Months&apos; and [Count of Weeks (copy)_1359854840897544]&lt;=3 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 6 Months&apos; and [Count of Weeks (copy)_1359854840897544]&lt;=6 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;All&apos; then &apos;Yes&apos;&#13;&#10;else &apos;No&apos;&#13;&#10;end' />
      </column>
      <column caption='Count of Weeks' datatype='integer' name='[Count of Days (copy)_1359854840598535]' role='measure' type='quantitative'>
