              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Date], {MAX([Date])})' />
            </column>
            <column caption='Period Filter' datatype='string' name='[Calculation_1359854841028617]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1359854839906309]=&apos;Last 7 Days&apos; AND [Calculation_1359854840291334]&lt;=7 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 4 Weeks&apos; and [Count of Days (copy)_1359854840598535]&lt;=4 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 8 Weeks&apos; and [Count of Days (copy)_1359854840598535]&lt;=8 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 3 Months&apos; and [Count of Weeks (copy)_1359854840897544]&lt;=3 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;Last 6 Months&apos; and [Count of Weeks (copy)_1359854840897544]&lt;=6 then &apos;Yes&apos;&#13;&#10;ELSEIF  [Parameters].[Parameter 1359854839906309]=&apos;All&apos; then &apos;Yes&apos;&#13;&#10;else &apos;No&apos;&#13;&#10;end' />
            </column>
            <column caption='Count of Weeks' datatype='integer' name='[Count of Days (copy)_1359854840598535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [Date], {MAX([Date])})' />
            </column>
            <column caption='Count of Months' datatype='integer' name='[Count of Weeks (copy)_1359854840897544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Date], {MAX([Date])})' />
