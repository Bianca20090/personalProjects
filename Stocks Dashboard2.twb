      <aliases enabled='yes' />
      <column caption='Clean Stock Name' datatype='string' name='[Calculation_0844183532617728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Stock Name]=&quot;OKTA&quot; then &quot;Okta&quot;&#13;&#10;ELSEif [Stock Name]=&quot;TSLA&quot; then &quot;Tesla&quot;&#13;&#10;elseif [Stock Name]=&quot;AMZN&quot; then &quot;Amazon&quot;&#13;&#10;elseif [Stock Name]=&quot;BBBY&quot; then &quot;Bed, Bath &amp; Beyond&quot;&#13;&#10;elseif [Stock Name]=&quot;SEDG&quot; then &quot;SolarEdge Technologies&quot;&#13;&#10;END' />
      </column>
      <column caption='Last Closing Price' datatype='real' name='[Calculation_0844183536164865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Date]={MAX([Date])}then [Close] end' />
      </column>
      <column caption='Current Value' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_0844183537115138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0844183536164865]* [Units Bought]' />
      </column>
      <column caption='P/L' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_0844183537307651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0844183537115138]-[Purchase Cost]' />
      </column>
      <column caption='Daily Value' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_0844183542874116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Close]*[Units Bought]' />
      </column>
      <column caption='Red/Green' datatype='string' name='[Calculation_0844183544324101]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Daily % change]&lt;0 then &quot;Red&quot;&#13;&#10;ELSEIF [Daily % change]&gt;=0 then &quot;Green&quot;&#13;&#10;end' />
      </column>
      <column caption='Stock Filter' datatype='boolean' name='[Calculation_0990419649658886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Stock Name]=[Parameters].[Parameter 0990419639717892]' />
      </column>
      <column caption='Current Price title' datatype='string' name='[Calculation_0990419652628487]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Current Price&quot;' />
      </column>
      <column caption='First closing price' datatype='real' name='[Calculation_0990419654049802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Day]={MIN([Day])} then [Close] end' />
      </column>
      <column caption='% change one year' datatype='real' name='[Calculation_0990419654234123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0844183536164865])-SUM([Calculation_0990419654049802])/SUM([Calculation_0990419654049802])' />
